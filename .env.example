# Copy to .env (server reads real environment variables; use your host's secret manager in production).

# --- Server ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database. SQLite for development, PostgreSQL for production:
#   sqlite:./data/aurora.db
#   postgres://user:password@host:5432/aurora      (add ?sslmode=require style options as your provider needs)
DATABASE_URL=sqlite:./data/aurora.db

# --- Sessions / security ---
SESSION_TTL_DAYS=14
COOKIE_NAME=aurora_sid
# Defaults to true when NODE_ENV=production. Set false only when serving over plain HTTP (e.g. a local production test).
# COOKIE_SECURE=true
# Set true when running behind a reverse proxy / load balancer that sets X-Forwarded-* (needed for correct client IPs in rate limits).
TRUST_PROXY=false
# Extra origins allowed to call the API (comma separated). Same-origin requests are always allowed.
ALLOWED_ORIGINS=
# Set false to close public registration.
REGISTRATION_OPEN=true
# scrypt cost (power of two). Default 65536 is a sound production value; lower only for tests.
# SCRYPT_N=65536

# Where the built client lives (default ../../client/dist relative to server/src)
# CLIENT_DIR=
# LOG_REQUESTS=false

# --- Client dev server only ---
# API_URL=http://localhost:4000
